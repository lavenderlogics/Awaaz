# Public client/SSR Supabase settings (safe to expose to Next.js client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only secret key (NEVER prefix with NEXT_PUBLIC_ or commit to Git)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Server-only 32+ char secret for wrapping approved unlock shares in unlock_approvals
AWAAZ_KEY_SECRET=replace-with-a-long-random-server-secret

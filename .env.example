# Public client/SSR Supabase settings (safe to expose to Next.js client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only secret key (NEVER prefix with NEXT_PUBLIC_ or commit to Git)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Upstash Redis (server-only distributed rate limiting, caching & Auto-Shred queues)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Secret bearer token protecting scheduled /api/cron/auto-shred execution
CRON_SECRET=replace-with-random-cron-secret

# Optional: Resend API key & sender for emailing committee admins when new members sign up
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Awaaz Security <no-reply@yourdomain.com>
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
ADMIN_APPROVAL_SECRET=replace-with-random-hmac-secret
BOOTSTRAP_ADMIN_EMAIL=first-admin@yourdomain.com
